# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql://deep_reverse:deep_reverse@db:5432/deep_reverse

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (MinIO locally, S3-compatible in prod) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=deep_reverse
STORAGE_SECRET_KEY=deep_reverse_dev
STORAGE_BUCKET=deep-reverse

# --- AI providers (wired in Ring 1 Phase 2 onward) ---
AI_PROVIDER=
AI_API_KEY=

# --- CORS ---
# Only needed if the browser talks to the API on a different origin than
# the Next.js dev-proxy default; see apps/web/next.config.js rewrites().
ALLOWED_ORIGINS=http://localhost:3000
