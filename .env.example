# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql://deep_reverse:deep_reverse@db:5432/deep_reverse

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (MinIO locally, S3-compatible in prod) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=deep_reverse
STORAGE_SECRET_KEY=deep_reverse_dev
STORAGE_BUCKET=deep-reverse

# --- AI provider ---
# Primary providers — set AI_PROVIDER and provide AI_API_KEY when that provider needs one:
#
#   anthropic  -> key from https://console.anthropic.com (Settings -> API Keys)
#                 new accounts get a one-time ~$5 trial credit
#   gemini     -> key from https://aistudio.google.com/apikey
#   groq       -> key from https://console.groq.com/keys (rate-limited)
#   ollama     -> local Ollama server; no API key needed
# Optional: GROQ_API_KEY also enables a text-only Groq fallback when the
# primary provider returns a rate-limit/quota error. It does not generate video.
AI_PROVIDER=gemini
AI_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional local text fallback: start it with `docker compose --profile local-ai up -d`
# then download the model with `docker compose exec ollama ollama pull qwen3:4b`.
# Local inference uses your computer's resources and does not generate video.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
PROTOTYPE_BUILDER_API_URL=https://ai-prototype-builder-s36q.vercel.app/api/generate

# --- CORS ---
# Only needed if the browser talks to the API on a different origin than
# the Next.js dev-proxy default; see apps/web/next.config.js rewrites().
ALLOWED_ORIGINS=http://localhost:3000
